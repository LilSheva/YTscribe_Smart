# ============================================
# YTS_bot — Шаблон переменных окружения
# Скопируйте этот файл как .env и заполните значения
# cp .env.example .env
# ============================================

# --- Telegram ---
BOT_TOKEN=123456789:AABBccDDeeFFggHHiiJJkkLLmmNNooPPqqRR

# --- API Keys ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OMNIROUTE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Base URL для Omniroute (OpenAI-совместимый endpoint)
OMNIROUTE_BASE_URL=https://omniroute.up.railway.app/v1

# --- Транскрибация (Speech-to-Text) ---
# Основной провайдер: groq (бесплатно, быстро)
# Fallback: omniroute (через OpenRouter/другие провайдеры)
TRANSCRIPTION_PROVIDER=groq
# Модель Whisper (доступные: whisper-large-v3, whisper-large-v3-turbo, distil-whisper-large-v3-en)
# whisper-large-v3-turbo — оптимально для RU+EN (быстрая, качественная)
WHISPER_MODEL=whisper-large-v3-turbo
# Максимальный размер файла для Groq free tier (MB)
WHISPER_MAX_FILE_MB=25

# --- Google Drive (путь к JSON-файлу сервисного аккаунта) ---
GDRIVE_CREDENTIALS_PATH=credentials/gdrive_service.json

# --- Медиа ---
# Браузер для извлечения cookies (chrome, firefox, edge, brave)
BROWSER_FOR_COOKIES=chrome
# Папка для временных файлов (по умолчанию: temp/)
TEMP_DIR=temp

# --- Feature Toggles (True / False) ---
# Отключение модуля = кнопки не рендерятся, вызовы возвращают заглушку
ENABLE_DOWNLOADER=True
ENABLE_TRANSCRIPT=True
ENABLE_LLM=True
ENABLE_DB=True
ENABLE_GDRIVE=False

# --- LLM Settings ---
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=4096

# --- Logging ---
# Уровень: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
